<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - EventRegistrationApp</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" />
    <style>
        .navbar {
            font-size: 1.5rem; /* Increase font size */
            padding: 0.25rem 1rem; /* Reduce padding */
        }

        .navbar-nav .nav-link.active {
            background-color: blue; /* Active tab background color */
            color: white !important; /* Active tab text color */
        }

        .navbar-brand img {
            width: 80px; /* Increase logo size */
            height: 80px; /* Increase logo size */
        }

        .navbar-right img {
            width: 40px; /* Size for the right-side image */
            height: 40px; /* Size for the right-side image */
        }

        .navbar-nav {
            align-items: center; /* Center align nav items vertically */
        }

        .nav-item {
            margin: 0; /* Remove margin from nav items */
        }

        .nav-link {
            padding: 0.5rem 1rem; /* Adjust padding for nav links */
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <a class="navbar-brand" asp-controller="Event" asp-action="Index">
                <img src="~/images/logo.svg" alt="EventRegistrationApp" />
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Event" asp-action="Index">Avaleht</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Event" asp-action="Create">Ürituse lisamine</a>
                    </li>
                </ul>
                <ul class="navbar-nav ml-auto navbar-right">
                    <li class="nav-item">
                        <img src="~/images/symbol.svg" alt="Symbol" />
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        @RenderBody()
    </div>
    <footer class="footer">
        <div class="container">
            <p class="text-muted">&copy; @DateTime.Now.Year - EventRegistrationApp</p>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>
