<a asp-controller="Event" asp-action="Details">Tagasi</a>

<script>
    function toggleParticipantType() {
        var isCompany = document.querySelector('input[name="IsCompany"]:checked').value === "true";
        document.getElementById("personFields").style.display = isCompany ? "none" : "block";
        document.getElementById("companyFields").style.display = isCompany ? "block" : "none";
    }

    // Tagab, et lehe laadimisel on õige väljade olek
    document.addEventListener("DOMContentLoaded", toggleParticipantType);
</script>
