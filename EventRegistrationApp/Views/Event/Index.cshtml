@model IEnumerable<EventRegistration.Domain.Models.Event>

@{
    ViewBag.Title = "Ürituste nimekiri";
}

<div class="container mt-4">
    <h2 class="mb-4">Ürituste nimekiri</h2>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Nimi</th>
            <th>Kuupäev</th>
            <th>Toimingud</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var eventItem in Model)
        {
            <tr>
                <td>@eventItem.Name</td>
                <td>@eventItem.Date.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="ManageParticipants" asp-route-id="@eventItem.Id" class="btn btn-info btn-sm">Osalejad</a>
                    <a asp-action="Delete" asp-route-id="@eventItem.Id" class="btn btn-danger btn-sm">Kustuta</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <a asp-action="Create" class="btn btn-primary">Lisa uus üritus</a>
</div>
