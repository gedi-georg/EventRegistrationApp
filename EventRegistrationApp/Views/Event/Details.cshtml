@model EventRegistration.Application.DTOs.EventDto

@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Name</h1>
<p><strong>Date:</strong> @Model.Date.ToShortDateString()</p>

<h3>Participants</h3>
<a asp-controller="Participant" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-primary mb-2">Add Participant</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var participant in Model.Participants)
        {
            <tr>
                <td>@participant.FullName</td>
                <td>
                    <a asp-controller="Participant" asp-action="Details" asp-route-id="@participant.Id" class="btn btn-sm btn-info">View</a>
                    <a asp-action="DeleteParticipant" asp-route-id="@participant.Id" class="btn btn-sm btn-danger">Remove</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Events</a>
