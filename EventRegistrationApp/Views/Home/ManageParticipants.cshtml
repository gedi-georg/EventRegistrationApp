@model IEnumerable<EventRegistration.Domain.Models.Participant>

<div class="container mt-4">
    <h3>Osavõtjad</h3>

    @foreach (var participant in Model)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="card-title">@participant.Person.FirstName @participant.Person.LastName</h5>
                <p class="card-text">Osavõtja tüüp: @participant.ParticipantType</p>
                <p class="card-text">Makseviis: @participant.PaymentMethod</p>

                <a href="@Url.Action("Edit", "Participant", new { id = participant.Id })" class="btn btn-warning">Muuda</a>
                <a href="@Url.Action("Delete", "Participant", new { id = participant.Id })" class="btn btn-danger">Kustuta</a>
            </div>
        </div>
    }

    <a href="@Url.Action("Create", "Participant", new { eventId = ViewData["EventId"] })" class="btn btn-primary">Lisa osavõtja</a>
</div>