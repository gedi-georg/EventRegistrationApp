@model EventRegistration.Application.DTOs.ParticipantDto

@{
    ViewData["Title"] = "Add Participant";
}

<h1>Add Participant</h1>

<form asp-action="Create">
    <input type="hidden" asp-for="EventId" />

    <div class="form-group">
        <label asp-for="PaymentMethodId"></label>
        <select asp-for="PaymentMethodId" class="form-control" asp-items="ViewBag.PaymentMethods"></select>
        <span asp-validation-for="PaymentMethodId" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-success">Add</button>
    <a asp-controller="Event" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-secondary">Back</a>
</form>

