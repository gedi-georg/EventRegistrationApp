@model EventRegistration.Application.DTOs.ParticipantCreateViewModel

@{
    ViewData["Title"] = "Add Participant";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" asp-controller="Participant" method="post">
    <input type="hidden" asp-for="Participant.EventId" />

    <!-- Dropdown for selecting Person or Company -->
    <div class="form-group">
        <label class="form-label">Select Participant Type</label>
        <select id="participantType" name="ParticipantType" class="form-control" onchange="toggleFields()">
            @foreach (var type in new[] {"Person", "Company"})
            {
                <option value="@type" selected="@(Model.ParticipantType == type ? "selected" : null)">@type</option>
            }
        </select>
    </div>

    <!-- Payment Method Dropdown -->
    <div class="form-group">
        <label asp-for="Participant.PaymentMethodId" class="form-label">Payment Method</label>
        <select asp-for="Participant.PaymentMethodId" class="form-control" asp-items="Model.PaymentMethods"></select>
        <span asp-validation-for="Participant.PaymentMethodId" class="text-danger"/>
    </div>

    <!-- Person specific fields -->
    <div id="personFields" class="participantFields">
        <div class="form-group">
            <label asp-for="Person.FirstName" class="form-label">First Name</label>
            <input asp-for="Person.FirstName" class="form-control"/>
            <span asp-validation-for="Person.FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Person.LastName" class="form-label">Last Name</label>
            <input asp-for="Person.LastName" class="form-control"/>
            <span asp-validation-for="Person.LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Person.PersonalIdCode" class="form-label">Personal ID Code</label>
            <input asp-for="Person.PersonalIdCode" class="form-control"/>
            <span asp-validation-for="Person.PersonalIdCode" class="text-danger"></span>
        </div>
    </div>

    <!-- Company specific fields -->
    <div id="companyFields" class="participantFields" style="display: none;">
        <div class="form-group">
            <label asp-for="Company.LegalName" class="form-label">Legal Name</label>
            <input asp-for="Company.LegalName" class="form-control"/>
            <span asp-validation-for="Company.LegalName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Company.RegistrationCode" class="form-label">Registration Code</label>
            <input asp-for="Company.RegistrationCode" class="form-control"/>
            <span asp-validation-for="Company.RegistrationCode" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Company.ParticipantsCount" class="form-label">Participants Count</label>
            <input asp-for="Company.ParticipantsCount" class="form-control"/>
            <span asp-validation-for="Company.ParticipantsCount" class="text-danger"></span>
        </div>
    </div>

    <!-- Additional Info -->
    <div class="form-group">
        <label asp-for="Participant.AdditionalInfo" class="form-label">Additional Info</label>
        <textarea asp-for="Participant.AdditionalInfo" class="form-control"></textarea>
        <span asp-validation-for="Participant.AdditionalInfo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <script>
        // Function to toggle between Person and Company fields
        function toggleFields() {
            var participantType = document.getElementById('participantType').value;

            if (participantType === 'Person') {
                document.getElementById('personFields').style.display = 'block';
                document.getElementById('companyFields').style.display = 'none';
            } else if (participantType === 'Company') {
                document.getElementById('companyFields').style.display = 'block';
                document.getElementById('personFields').style.display = 'none';
            }
        }

        // Call toggleFields() on page load to display the correct fields
        window.onload = function() {
            toggleFields(); // Initialize the correct fields based on the default dropdown value
        };
    </script>
}
