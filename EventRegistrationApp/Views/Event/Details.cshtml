@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EventRegistration.Application.DTOs.EventParticipantsViewModel

<h2>@Model.EventName</h2>
<p><strong>Kuupäev:</strong> @Model.EventDate.ToString("dd.MM.yyyy")</p>
<p><strong>Asukoht:</strong> @Model.EventLocation</p>

@if (!Model.IsPastEvent)
{
    <a asp-action="AddParticipant" asp-route-eventId="@Model.EventId" class="btn btn-primary">Lisa osaleja</a>
}

<table class="table mt-3">
    <thead>
    <tr>
        <th>Nimi</th>
        <th>Isikukood / Registrikood</th>
        <th>Tegevused</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var participant in Model.Participants)
    {
        <tr>
            <td>@participant.FullName</td>
            <td>@participant.IdCode</td>
            <td>
                <a asp-action="Details" asp-controller="Participant" asp-route-id="@participant.Id" class="btn btn-sm btn-info">Vaata</a>
                @if (!Model.IsPastEvent)
                {
                    <a asp-action="DeleteParticipant"
                       asp-route-id="@participant.Id"
                       asp-route-eventId="@Model.EventId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Oled kindel?');">
                        Kustuta
                    </a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Tagasi avalehele</a>