@model EventRegistration.Domain.Models.Participant

@{
    ViewBag.Title = "Osavõtja detail";
}

<h2>Osavõtja detail</h2>

<form asp-action="ParticipantDetails" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="EventId" value="@Model.EventId" />
    <div>
        <label for="Name">Nimi</label>
        <input type="text" id="PersonId" name="Person" value="@Model.PersonId" />
    </div>
    <div>
        <label for="Email">Email</label>
        <input type="text" id="CompanyId" name="Company" value="@Model.CompanyId" />
    </div>
    <button type="submit">Salvesta</button>
</form>
