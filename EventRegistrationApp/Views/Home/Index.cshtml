@model IEnumerable<EventRegistration.Domain.Models.Event>

<div class="container mt-4">
    <h2 class="mb-4">Ürituste loetelu</h2>

    @foreach (var eventItem in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@eventItem.Name</h5>
                <p class="card-text">Toimumisaeg: @eventItem.Date.ToString("dd.MM.yyyy HH:mm")</p>
                <p class="card-text">Asukoht: @eventItem.Location</p>
                <p class="card-text">Osavõtjate arv: @eventItem.Participants.Count</p>

                <a href="@Url.Action("ManageParticipants", "Event", new { id = eventItem.Id })" class="btn btn-info">Kuva osavõtjad</a>
                <a href="@Url.Action("Delete", "Event", new { id = eventItem.Id })" class="btn btn-danger">Kustuta üritus</a>
            </div>
        </div>
    }

    <a href="@Url.Action("Create", "Event")" class="btn btn-primary">Lisa uus üritus</a>
</div>